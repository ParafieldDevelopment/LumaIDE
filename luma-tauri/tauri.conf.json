{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.1.0-alpha",
  "identifier": "com.moonlight.luma",
  "build": {
    "beforeDevCommand": {
      "script": "npm install && npm run dev",
      "cwd": "src/vite"
    },
    "beforeBuildCommand": {
      "script": "npm install && npm run build",
      "cwd": "src/vite"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Luma.icon"
    ]
  }
}